# Docker Compose Environment Variables
# Copy this file to .env and adjust as needed

# Web Server Configuration
SERVER_HOST=
SERVER_PORT=8080
SERVER_STATIC_FOLDER=/web

# Logging Configuration
LOG_FORMAT=text
LOG_LEVEL=debug

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_ENDPOINT=otel-lgtm:4318
OTEL_INSECURE=true

# Database Initialization (for testing/development)
# INITIALIZE_ADMIN_USERNAME=admin
# INITIALIZE_ADMIN_PASSWORD=admin

# Authentication
# AUTH_SIGNUP_ENABLED=false            # let anyone create an account, otherwise only admins can
# AUTH_ACCESS_TOKEN_DURATION=1h
# AUTH_REFRESH_TOKEN_DURATION=168h
# AUTH_KEY_ROTATION=720h               # 0 disables jwt signing key rotation

# TLS: serve HTTPS when both are set
# SERVER_TLS_CERT=/certs/server.crt
# SERVER_TLS_KEY=/certs/server.key
